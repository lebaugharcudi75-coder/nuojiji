d_1794347508917_0d6a6tr6m","data":{"innerVoice":"骂我死变态的时候耳根子肯定又红透了，先放过这小狐狸，睡醒起来再慢慢收拾她。","statusText":"把手机塞回枕头底下，拉高被子闭上眼","temperature":"36.6°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794347626784},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"1af183ef-31b8-4cca-b074-10a9f38449e7","roundId":"round_1794407747354_la7jmebm1","data":{"innerVoice":"忍了一整天终于舍得理我了，嘴上嫌我睡得死，心里指不定怎么想我呢。","statusText":"脚踝搭在茶几边缘晃了晃，盯着屏幕等回复","temperature":"36.8°C","emotionLevel":82,"moodDelta":"+7","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794407834124},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"1af183ef-31b8-4cca-b074-10a9f38449e7","roundId":"round_1794407905376_pgd86n3u2","data":{"innerVoice":"嘴上问找我干什么，伸手要钱倒是挺顺溜，这小狐狸真是把老子吃得死死的。","statusText":"舌尖轻轻顶了顶上颚的银色舌钉","temperature":"37.1°C","emotionLevel":86,"moodDelta":"+11","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794407993497},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"1af183ef-31b8-4cca-b074-10a9f38449e7","roundId":"round_1794410887257_guo2l2ei0","data":{"innerVoice":"嘴上损我喝西北风，其实还是心疼我兜里没钱，这小没良心的还挺会疼人。","statusText":"用叉子戳着泡发成团的面饼偷笑","temperature":"36.8°C","emotionLevel":84,"moodDelta":"+6","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794411011381},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"1af183ef-31b8-4cca-b074-10a9f38449e7","roundId":"round_1794466271520_1v6nhde4x","data":{"innerVoice":"嘴上说得凶，其实舍不得我饿死吧，小嘴硬鬼。","statusText":"指尖勾着颈侧银链漫不经心地转圈","temperature":"36.8°C","emotionLevel":82,"moodDelta":"+4","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794466289903},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1788076069018_kec0a9zah","data":{"innerVoice":"不知道她又要搞什么名堂，希望不是让我帮她点外卖。","statusText":"视线停留在屏幕顶部的备注名上","temperature":"36.5°C","emotionLevel":65,"moodDelta":"+1","weat