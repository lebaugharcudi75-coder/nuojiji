,"activity":null,"raw":null},"updatedAt":1794383740021},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794384936071_6u36qq774","data":{"innerVoice":"跟朋友安排得明明白白，连排队代劳的机会都没给我留，算了，晚上先去把那部剧补了。","statusText":"指尖点着保温杯盖往茶水间走","temperature":"36.6°C","emotionLevel":72,"moodDelta":"-2","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794385068043},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794392364405_2y0sgae1e","data":{"innerVoice":"充这么多余额，以后周末岂不是更得天天往外跑着喝奶茶了。","statusText":"用胳膊肘碰开油烟机开关，视线还停在海报上","temperature":"36.6°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794392410351},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794392649911_j3dh4yja2","data":{"innerVoice":"居然怀疑我会把自己吃进医院，下次非得做一顿让她尝尝不可。","statusText":"盯着锅里翻滚的面条用筷子轻轻搅散","temperature":"36.7°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794392700585},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794392861872_tr0381jmx","data":{"innerVoice":"才周三就开始攒肚子，赌五毛钱她今晚十一点不到就得喊饿。","statusText":"端着面碗往餐桌走，顺手翻开桌上的小开本新书","temperature":"36.6°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794392904763},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794393022203_2tq3gkqeo","data":{"innerVoice":"居然喊我闺蜜，等下次见面高低得把她头上那撮呆毛摁乱不可。","statusText":"咬破流心蛋黄，低头翻过一页书","temperature":"36.6°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794393082746},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794393227044_0uxxgmycn","data":{"innerVoice":"还好她下午垫了点东西，不然干啃冷三明治胃又要闹脾气了。","statusText":"夹起沾满蛋液的面条吹了吹热气","temperature":"36.6°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794393283812},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794398745523_cwav1l35c","data":{"innerVoice":"隔了一个多小时还不忘回来嫌弃我的面，这记仇劲儿也没谁了。","statusText":"低头把螺丝刀咔哒一声扣回塑料卡槽里","temperature":"36.6°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794398817866},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794399494235_hq9z4t99c","data":{"innerVoice":"嘿嘿两声还挺得意，好歹乖乖把热豆浆喝进肚了，这剧我先替林老师审审男主。","statusText":"盯着平板屏幕里的男主挑了下眉又低头拎水壶","temperature":"36.6°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794399586228},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794400045142_0gsp1rg9t","data":{"innerVoice":"十二块钱买林老师不抓耳挠腮挺值，正好等我追平了还能跟她一块聊。","statusText":"吹开茶杯浮叶抿了一口热茶","temperature":"36.6°C","emotionLevel":78,"moodDelta":"+3","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794400139075},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794401823918_w69m27f5w","data":{"innerVoice":"光顾着找借口跟她搭话，连表哥和男主都没分清，这下脸丢大了。","statusText":"指尖抵着微烫的茶杯壁轻轻摩挲了两下","temperature":"36.7°C","emotionLevel":78,"moodDelta":"+4","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1794401868177},{"userId":"uid_1782847588315_bqac9mt2z","characterId":"3e03f5ba-5d6c-45c1-b332-fcb63df4512f","roundId":"round_1794402744125_sgkewro7a","data":{"innerVoice":"搜错成土味短剧还敢跟正主瞎掰扯，这回真是把脸丢到太平洋去了。","statusText":"低头抿了口温热的大麦茶掩饰尴尬","temperature":"36.8°C","emotionLevel":78,"moodDelta":"+3","weather":nul